# Website: this is the only content setting the Next.js server needs.
# Leave unset for local public/data/catalog.json or the empty state.
# ARTFOLIO_CONTENT_BASE_URL=https://content.example.com/artfolio/

# Worker: set environment variables in the shell or GitHub Actions.
# Python does not automatically load .env files. Never commit real credentials.
# ARTFOLIO_STATE_BUCKET=artfolio-private
# ARTFOLIO_PUBLIC_BUCKET=artfolio-public
# ARTFOLIO_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# ARTFOLIO_S3_REGION=auto
# ARTFOLIO_S3_PREFIX=artfolio
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ARTFOLIO_ALERT_WEBHOOK=
# ARTFOLIO_HEARTBEAT_URL=
